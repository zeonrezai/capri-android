<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- her chat's AI, Ollama on your network, and the hook server Claude Code reaches -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- her updates, installed from the app (Android still asks you to confirm each one) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- on top of your apps, as she is on top of your windows on the desktop -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- "Capri, …": only if you turn it on in Settings, and only with the screen on (Ears.kt) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- your calendar (1.9.0): optional, read only, asked only if you turn it on in «Tú» (Agenda.kt) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Capri, mira mi pantalla": Android's screen capture, asked each time (Eyes.kt) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- gamer mode on its own when a game is in front: only if you turn it on and give "Acceso de uso" -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- "Start with Windows", here "start with the phone" -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Termux's RUN_COMMAND, to plug her hooks in from her own button -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- the phone's own speech recognizer and voice, for "Capri, …" -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LookActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Compartir → Capri: a picture, a video or a text from any app, to her chat -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_target"
            android:icon="@mipmap/ic_launcher"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ClosetActivity"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".CapriService"
            android:exported="${serviceExported}"
            android:foregroundServiceType="specialUse|microphone|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Desktop companion character drawn over other apps; listens on 127.0.0.1 for coding-assistant hook events." />
        </service>

        <service
            android:name=".CapriNotifications"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- the downloaded update, for Android's installer screen only (ApkProvider.kt) -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />

        <!-- Optional foreground screen reading/clicks, only when the user enables it -->
        <service
            android:name=".CapriControlService"
            android:exported="true"
            android:label="@string/capri_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capri_control" />
        </service>

        <!-- Capri peeking in your notification panel (1.9.0): off unless you turn it on in Android's
             Accessibility settings; it's only told when that panel opens (res/xml/capri_peek.xml) -->
        <service
            android:name=".PeekService"
            android:exported="true"
            android:label="@string/peek_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capri_peek" />
        </service>

        <!-- every few hours, even with her off: is there a new version? (Updater.kt) -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".CapriTile"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- her widget on your home screen (1.9.0): quick things, in her colors -->
        <receiver
            android:name=".CapriWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/capri_widget" />
        </receiver>
        <!-- its taps: only this app's widget reaches it -->
        <receiver
            android:name=".CapriWidget$Tap"
            android:exported="false" />

        <!-- her class and calendar reminders: her own alarm only (Agenda.kt) -->
        <receiver
            android:name=".Agenda$Fire"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
